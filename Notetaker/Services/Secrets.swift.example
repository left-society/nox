import Foundation

/// Local secrets — copy this file to `Secrets.swift` and fill in
/// the real values for each environment. `Secrets.swift` is
/// gitignored so the literals never reach a public commit.
///
/// Rotating a secret:
///   • Notion: https://www.notion.so/profile/integrations → nox →
///     Refresh OAuth client secret. Notion shows the new value once;
///     paste it below.
enum Secrets {
    /// Notion public-integration Client Secret.
    static let notionClientSecret = "secret_REPLACE_WITH_YOUR_NOTION_CLIENT_SECRET"
}
