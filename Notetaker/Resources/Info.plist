<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>nox</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.7</string>
	<key>CFBundleVersion</key>
	<string>8</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>Notetaker reads the current tab URL from your browser when you press ⌥⌘V so it can download the video you're watching.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Aritra Debnath.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Notetaker transcribes your voice offline to create notes. Audio never leaves your Mac.</string>
	<!-- Sparkle auto-update — see scripts/release.sh + appcast.xml -->
	<!-- Sparkle polls this XML for new versions daily. Hosted via
	     GitHub Pages on the public release repo (left-society/nox)
	     and served from the custom domain trynox.app. The same
	     repo stores release notes HTML. Actual DMG files are
	     attached to GitHub Releases. The appcast points to the
	     per release download URLs. -->
	<key>SUFeedURL</key>
	<string>https://trynox.app/appcast.xml</string>
	<!-- SUPublicEDKey: Sparkle's EdDSA public key. The matching
	     PRIVATE key lives ONLY in your local keychain (generated
	     by scripts/sparkle-bin/generate_keys). Sparkle verifies
	     each downloaded update against this public key before
	     installing — protects users from MITM/CDN compromise. -->
	<key>SUPublicEDKey</key>
	<string>n/eovhDL82Gp75QMByGpBpwU9/SpYLFEFOoElzSIkoo=</string>
	<!-- Check every 4 hours. Sparkle's default is 24h, but for a
	     fast-moving app shipping multiple versions a day, that
	     means users wait a full day after install to see the next
	     version. Sparkle is silent when nothing new is available
	     (no UI), so 4h is not intrusive — the prompt only appears
	     when there is genuinely a new build. Users can also trigger
	     a manual check from the menubar ("Check for Updates…")
	     when they want it instantly. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>14400</integer>
</dict>
</plist>
